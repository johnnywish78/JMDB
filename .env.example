# JMDB environment configuration example.
# Copy to .env (gitignored) or use ~/.jmdb/config/secrets.json, or the GUI
# Settings screen. Values are read in this order: environment > secrets file.

# TMDB API key (v3 auth key). Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# OMDb API key. Get one at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Optional providers
FANART_TV_API_KEY=
LASTFM_API_KEY=
THEAUDIODB_API_KEY=

# Optional: override the JMDB data directory (default: ~/.jmdb)
# JMDB_HOME=/home/you/.jmdb
