/* JMDB light theme (derived) */
/* JMDB dark theme — cinematic */

QWidget {
    background-color: #f4f5f8;
    color: #232838;
    font-family: "Segoe UI", "Ubuntu", "DejaVu Sans", sans-serif;
    font-size: 13px;
}
QMainWindow, QDialog { background-color: #f4f5f8; }

/* ---------- sidebar ---------- */
#Sidebar {
    background-color: #e9ebf1;
    border-right: 1px solid #d6dae4;
}
#Sidebar QPushButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 9px 14px;
    text-align: left;
    color: #5a6275;
    font-size: 13.5px;
}
#Sidebar QPushButton:hover { background-color: #eef0f5; color: #232838; }
#Sidebar QPushButton:checked { background-color: #dfe7f5; color: #b06f0f; font-weight: 600; }
#SidebarLogo {
    color: #d98a1f;
    font-size: 20px;
    font-weight: 800;
    padding: 18px 14px 4px 14px;
}
#SidebarTagline { color: #8a90a0; font-size: 10.5px; padding: 0 14px 14px 16px; }

/* ---------- topbar ---------- */
#Topbar {
    background-color: #ffffff;
    border-bottom: 1px solid #d6dae4;
}
#Topbar QLabel { color: #2c3245; }
#SearchEntry {
    background-color: #ffffff;
    border: 1px solid #c2c8d6;
    border-radius: 16px;
    padding: 7px 14px;
    color: #232838;
    font-size: 13px;
}
#SearchEntry:focus { border: 1px solid #d98a1f; }

/* ---------- screens & content ---------- */
#ScreenTitle { font-size: 24px; font-weight: 700; color: #141826; }
#SectionHeader { font-size: 16px; font-weight: 700; color: #141826; }
#SectionMore { color: #d98a1f; background: transparent; border: none; font-size: 12px; }
#SectionMore:hover { text-decoration: underline; }
#HeroBackdrop QLabel { color: white; }
#HeroTitle { font-size: 34px; font-weight: 800; color: #ffffff; }
#HeroTagline { color: #4c5366; font-size: 14px; }
#MutedLabel { color: #697083; font-size: 12px; }
#BigValue { font-size: 26px; font-weight: 800; color: #141826; }
#StatCard {
    background-color: #eef0f5;
    border-radius: 10px;
    padding: 14px;
}
#CardPanel {
    background-color: #eef0f5;
    border-radius: 12px;
    border: 1px solid #d6dae4;
}
#DetailPanel {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #d6dae4;
}

/* ---------- buttons ---------- */
QPushButton {
    background-color: #dfe3ec;
    border: 1px solid #c2c8d6;
    border-radius: 8px;
    padding: 7px 16px;
    color: #232838;
}
QPushButton:hover { background-color: #d2d8e5; border-color: #a9b1c4; }
QPushButton:pressed { background-color: #c9cfdc; }
QPushButton:disabled { color: #8a90a0; background-color: #e5e8ef; }
QPushButton#PrimaryButton, #PlayButton {
    background-color: #d98a1f;
    border: none;
    color: #ffffff;
    font-weight: 700;
    padding: 10px 22px;
}
QPushButton#PrimaryButton:hover, #PlayButton:hover { background-color: #e69a35; }
QPushButton#DangerButton { background-color: #a33d40; border-color: #8c3236; }
QPushButton#DangerButton:hover { background-color: #93373b; }
QPushButton#FlatIconButton {
    background: transparent; border: none; padding: 6px;
}
QPushButton#FlatIconButton:hover { background-color: #dfe3ec; border-radius: 6px; }

/* ---------- cards ---------- */
#PosterCard { background: transparent; }
#PosterTitle { font-weight: 600; color: #232838; font-size: 12.5px; }
#PosterYear { color: #697083; font-size: 11px; }
#ProgressOverlay { background-color: #d98a1f; }

/* ---------- lists / tables ---------- */
QListWidget, QTableView, QTreeView, QListView {
    background-color: #ffffff;
    border: 1px solid #d6dae4;
    border-radius: 8px;
    alternate-background-color: #eef0f5;
    outline: none;
}
QListWidget::item, QListView::item { padding: 7px; border-radius: 6px; }
QListWidget::item:selected, QListView::item:selected { background-color: #dfe7f5; color: #d98a1f; }
QListWidget::item:hover, QListView::item:hover { background-color: #ffffff; }
QHeaderView::section {
    background-color: #eef0f5;
    border: none;
    border-bottom: 1px solid #d6dae4;
    padding: 7px;
    color: #4c5366;
}
QTableView { gridline-color: #d6dae4; }

/* ---------- inputs ---------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #c2c8d6;
    border-radius: 7px;
    padding: 6px 10px;
    color: #232838;
    selection-background-color: #d98a1f;
    selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus { border-color: #d98a1f; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c2c8d6;
    selection-background-color: #dfe7f5;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px; border-radius: 4px;
    border: 1px solid #a9b1c4; background: #ffffff;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #d98a1f; border-color: #d98a1f;
}

/* ---------- tabs ---------- */
QTabWidget::pane { border: 1px solid #d6dae4; border-radius: 8px; top: -1px; }
QTabBar::tab {
    background: transparent;
    padding: 8px 18px;
    color: #5a6275;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected { color: #d98a1f; border-bottom: 2px solid #d98a1f; }
QTabBar::tab:hover { color: #232838; }

/* ---------- scrollbars ---------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #c2c8d6; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #a9b1c4; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #c2c8d6; border-radius: 5px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { height: 0; width: 0; }

/* ---------- player ---------- */
#PlayerWindow { background-color: #000000; }
#PlayerControls {
    background-color: rgba(240, 242, 247, 235);
    border-top: 1px solid rgba(20, 24, 38, 24);
}
#PlayerControls QLabel { color: #232838; }
#PlayerTitle { font-weight: 700; font-size: 14px; color: #ffffff; }
#PositionSlider::groove:horizontal { height: 5px; background: #c9cfdd; border-radius: 2px; }
#PositionSlider::sub-page:horizontal { background: #d98a1f; border-radius: 2px; }
#PositionSlider::handle:horizontal {
    width: 13px; height: 13px; margin: -5px 0; border-radius: 6px;
    background: #d98a1f;
}
#VolumeSlider::groove:horizontal { height: 5px; background: #c9cfdd; border-radius: 2px; }
#VolumeSlider::sub-page:horizontal { background: #5a6275; border-radius: 2px; }
#VolumeSlider::handle:horizontal {
    width: 11px; height: 11px; margin: -4px 0; border-radius: 5px; background: #232838;
}

/* ---------- toast ---------- */
#Toast {
    background-color: #ffffff;
    border: 1px solid #c2c8d6;
    border-radius: 10px;
    padding: 10px 16px;
    color: #232838;
}
#Toast[level="success"] { border-color: #3f7d4e; }
#Toast[level="warning"] { border-color: #9c7326; }
#Toast[level="error"] { border-color: #9c3d40; }

/* ---------- misc ---------- */
QToolTip {
    background-color: #ffffff;
    color: #232838;
    border: 1px solid #c2c8d6;
    padding: 5px 8px;
    border-radius: 5px;
}
QSplitter::handle { background-color: #d6dae4; }
QProgressBar {
    background-color: #ffffff;
    border: 1px solid #c2c8d6;
    border-radius: 6px;
    text-align: center;
    color: #232838;
    height: 14px;
}
QProgressBar::chunk { background-color: #d98a1f; border-radius: 5px; }
QGroupBox {
    border: 1px solid #d6dae4;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 6px;
    font-weight: 600;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #4c5366; }
