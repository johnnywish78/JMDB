/* JMDB light theme — tokens {{ACC}}/{{ACC2}}/{{INK}} replaced at load. */

QWidget { background: #f3f4f8; color: #171a22; font-size: 13px; }
QMainWindow, QDialog { background: #f3f4f8; }

#Sidebar { background: #eceef3; border-right: 1px solid #dde1ea; }
#Sidebar QListWidget { background: transparent; border: none; outline: none; }
#Sidebar QListWidget::item { padding: 9px 12px; margin: 1px 8px; border-radius: 8px; color: #5c6478; }
#Sidebar QListWidget::item:hover { background: #ffffff; color: #171a22; }
#Sidebar QListWidget::item:selected { background: #ffffff; color: #171a22; border-left: 3px solid {{ACC}}; }

#TopBar { background: #ffffff; border-bottom: 1px solid #dde1ea; }
#SearchEdit { background: #ffffff; border: 1px solid #dde1ea; border-radius: 10px; padding: 8px 12px; }
#SearchEdit:focus { border-color: {{ACC}}; }

QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #c9cfe0; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; }
QScrollBar::handle:horizontal { background: #c9cfe0; border-radius: 5px; min-width: 30px; }

QPushButton { background: #ffffff; border: 1px solid #dde1ea; border-radius: 9px; padding: 7px 14px; }
QPushButton:hover { border-color: #c9cfe0; }
QPushButton[accent="true"] { background: {{ACC}}; color: {{INK}}; border: none; font-weight: 700; }
QPushButton[accent="true"]:hover { background: {{ACC2}}; }

QLineEdit, QComboBox, QSpinBox { background: #ffffff; border: 1px solid #dde1ea; border-radius: 8px; padding: 6px 10px; }
QLineEdit:focus, QComboBox:focus { border-color: {{ACC}}; }
QComboBox QAbstractItemView { background: #ffffff; border: 1px solid #c9cfe0; }

#MediaCard { background: #ffffff; border: 1px solid #dde1ea; border-radius: 12px; }
#CardTitle { font-weight: 600; }
#CardMeta { color: #9aa2b5; font-size: 11px; }
#RatingBadge { background: rgba(255,255,255,220); color: #171a22; border-radius: 6px; padding: 2px 6px; font-weight: 700; font-size: 11px; }

#SectionTitle { font-size: 18px; font-weight: 600; }
#Muted { color: #5c6478; }
#Panel { background: #ffffff; border: 1px solid #dde1ea; border-radius: 12px; }
#EmptyState { border: 1px dashed #c9cfe0; border-radius: 12px; color: #5c6478; }

QTabWidget::pane { border: 1px solid #dde1ea; border-radius: 8px; }
QTabBar::tab { background: #f0f1f6; color: #5c6478; padding: 7px 14px; border: 1px solid #dde1ea; border-bottom: none; border-top-left-radius: 8px; border-top-right-radius: 8px; }
QTabBar::tab:selected { color: #171a22; background: #ffffff; border-color: {{ACC}}; }

QSlider::groove:horizontal { height: 5px; background: #dde1ea; border-radius: 3px; }
QSlider::handle:horizontal { width: 14px; height: 14px; margin: -5px 0; border-radius: 7px; background: {{ACC}}; }
QSlider::sub-page:horizontal { background: {{ACC}}; border-radius: 3px; }

QToolTip { background: #ffffff; color: #171a22; border: 1px solid #c9cfe0; padding: 4px 8px; }
QStatusBar { background: #ffffff; border-top: 1px solid #dde1ea; color: #5c6478; }
QListWidget { background: #ffffff; border: 1px solid #dde1ea; border-radius: 10px; outline: none; }
QListWidget::item { padding: 8px; border-bottom: 1px solid #f0f1f6; }
QListWidget::item:hover { background: #f0f1f6; }
QListWidget::item:selected { background: #e8eaf2; }
